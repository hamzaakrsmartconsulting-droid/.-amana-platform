# Copier vers .env.local et compléter.

# --- Supabase (local après `npm run supabase:start`, ou projet cloud)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 0 = auth réelle ; 1 = bypass middleware (dev uniquement)
DEV_BYPASS_AUTH=0

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# UUID du conseiller seed local (supabase/seed.sql → conseiller@amana.local)
AMANA_DEFAULT_CONSEILLER_ID=0745a52d-de63-462b-a4be-5465a599bc8a
AMANA_INTERNAL_SECRET=
# Appels serveur / webhooks (localhost ou ngrok en dev)
AMANA_BASE_URL=http://localhost:3000
# Liens e-mails : localhost en dev, platform.amana-patrimoine.fr en prod (voir lib/app-url.ts)
AMANA_CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_ORIAS_NUM=25009552
NEXT_PUBLIC_APP_URL=http://localhost:3000
YOUSIGN_API_KEY=
YOUSIGN_BASE_URL=https://api-sandbox.yousign.app
YOUSIGN_WEBHOOK_SECRET=
DEV_MOCK_YOUSIGN=0
EMAIL_PROVIDER=resend
EMAIL_FROM="Amana Patrimoine <noreply@amana-patrimoine.fr>"
RESEND_API_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=