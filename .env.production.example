# =============================================================================
# AMANA Patrimoine - Variables d'environnement PRODUCTION (EC2 / Docker)
#
# 1. Copier ce fichier en .env.production sur le serveur :
#      cp .env.production.example .env.production
# 2. Remplir TOUTES les valeurs marquées [OBLIGATOIRE].
# 3. Vérifier le fichier : `docker compose --env-file .env.production config`
# 4. Démarrer : `docker compose --env-file .env.production up -d`
#
# IMPORTANT - .env.production NE DOIT JAMAIS être commit (déjà dans .gitignore).
# =============================================================================

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── Supabase (projet cloud — PAS le stack local 127.0.0.1) ─────────────────
# [OBLIGATOIRE]
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role : JWT "service_role" (eyJ...), PAS la "secret key" (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic (agents IA) ──────────────────────────────────────────────────
# [OBLIGATOIRE] — Régénérer une clé spécifique prod, ne pas réutiliser la dev.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── URLs canoniques ────────────────────────────────────────────────────────
# [OBLIGATOIRE] — Tous identiques en prod, domaine officiel.
AMANA_BASE_URL=https://platform.amana-patrimoine.fr
AMANA_CLIENT_URL=https://platform.amana-patrimoine.fr
NEXT_PUBLIC_APP_URL=https://platform.amana-patrimoine.fr

# ─── Secrets internes (générer avec : openssl rand -hex 32) ─────────────────
# [OBLIGATOIRE]
AMANA_INTERNAL_SECRET=
CRON_SECRET=

# UUID du conseiller par défaut dans le projet Supabase prod (auth.users).
AMANA_DEFAULT_CONSEILLER_ID=

# ─── E-mails transactionnels (Resend, domaine vérifié SPF/DKIM) ─────────────
# [OBLIGATOIRE]
EMAIL_PROVIDER=resend
EMAIL_FROM="Amana Patrimoine <noreply@amana-patrimoine.fr>"
RESEND_API_KEY=
AMANA_ADMIN_EMAIL=admin@amana-patrimoine.fr
ADMIN_NOTIFICATION_EMAIL=admin@amana-patrimoine.fr

# ─── Yousign (PRODUCTION, pas la sandbox) ───────────────────────────────────
# [OBLIGATOIRE]
YOUSIGN_API_KEY=
YOUSIGN_BASE_URL=https://api.yousign.app
YOUSIGN_WEBHOOK_SECRET=
DEV_MOCK_YOUSIGN=0

# ─── Public — ORIAS / Calendly ──────────────────────────────────────────────
NEXT_PUBLIC_ORIAS_NUM=25009552
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/amana-patrimoine/visio
NEXT_PUBLIC_CALENDLY_PREMIUM_URL=https://calendly.com/amana-patrimoine/premium

# ─── SMTP (optionnel — ne définir QUE si EMAIL_PROVIDER=smtp) ───────────────
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=1
# SMTP_USER=
# SMTP_PASS=

# ─── DEV-ONLY — NE PAS DÉFINIR EN PROD ──────────────────────────────────────
# DEV_BYPASS_AUTH=                    # = 0 ou absent
# NEXT_PUBLIC_DEV_INSTANT_AUTH=       # absent
# NEXT_PUBLIC_DEV_LOGIN_EMAIL=        # absent
# NEXT_PUBLIC_DEV_LOGIN_PASSWORD=     # absent
